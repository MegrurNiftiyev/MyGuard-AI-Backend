# ==========================================
# MyGuard AI Models - Environment Template
# ==========================================

# 1. Service Auth & Logging
# Secure 64-character hex token for Node.js -> FastAPI communication
INTERNAL_SERVICE_TOKEN=your-secure-secret-token
LOG_LEVEL=INFO

# 2. CORS / Origin Security Middleware
# Comma-separated allowed origins (e.g. Render backend + Swagger UI / Localhost testing)
ALLOWED_ORIGINS=https://myguard-backend-i4ll.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# 3. Supabase Dataset Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=ey... (Public Anon Key)
SUPABASE_SERVICE_ROLE_KEY=ey... (Recommended for backend server usage)
SUPABASE_STORAGE_BUCKET=team-files
DATASET_BASE_DIR=./data/raw

# 4. Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH=./mygurad-firebase-admin.json
FIREBASE_CREDENTIALS_JSON=
