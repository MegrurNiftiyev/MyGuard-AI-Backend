# MongoDB connection string (same instance as the Node.js backend)
MONGO_URI=mongodb://localhost:27017

# Database name
DB_NAME=myguard

# Shared secret for service-to-service auth (Node.js backend sends this in X-Internal-Token header)
INTERNAL_SERVICE_TOKEN=change-me-to-a-real-secret

# Service host/port (used by Dockerfile/uvicorn)
HOST=0.0.0.0
PORT=8000
